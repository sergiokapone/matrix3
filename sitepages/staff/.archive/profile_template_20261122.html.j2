{# ═══════════════════════════════════════════════════════════════════════════
   МАКРОС: collapsible <details> секція
════════════════════════════════════════════════════════════════════════════ #}
{% macro collapsible(title) %}
<details style="margin: 10px 0;">
<summary style="cursor: pointer; font-weight: bold; font-family: 'Segoe UI',Tahoma,Geneva,Verdana,sans-serif; color: #1a3c6d; background: linear-gradient(135deg,#eef2f9 0%,#dce6f4 100%); border-left: 5px solid #1a3c6d; padding: 10px 15px; border-radius: 0 6px 6px 0; display: list-item; gap: 8px; user-select: none;">{{ title }}</summary>
<div style="background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
{{ caller() }}
</div>
</details>
{% endmacro %}

{# ── SECTION HEADER ── #}
{% macro section_h4(title) %}
<h4 style="font-size: 20px; border-bottom: 1px solid #ddd; display: inline-block; padding-bottom: 5px; margin-left: 20px; width: 50%;">{{ title }}</h4>
{% endmacro %}

{# ── COURSE LIST ── #}
{% macro course_list(courses) %}
<ul>
{% for course in courses %}
 	<li>{% if course.url %}<a href="{{ course.url }}">{{ course.title }}</a>{% else %}{{ course.title }}{% endif %}{% if course.description %} ({{ course.description }}){% endif %}</li>
{% endfor %}
</ul>
{% endmacro %}

{# ══════════════════════════════════════════════════════════════════════════ #}

<div class="profile-container">

{# ── HEADER ── #}
<div class="header" style="text-align: center;">
<h2 style="margin: 10px 0;">{{ teacher.name }}</h2>
{% set title_line = [] %}
{% if teacher.degree %}{% set _ = title_line.append(teacher.degree) %}{% endif %}
{% if teacher.academic_title %}{% set _ = title_line.extend(teacher.academic_title) %}{% endif %}
{% if title_line %}<strong>{{ title_line | join(", ") }}</strong>{% endif %}
{% if teacher.position %}<br><strong>{{ teacher.position }}</strong>{% endif %}
</div>

<hr style="margin: 20px 0; border: none; border-top: 1px solid #ddd;">

{# ── CONTACTS ── #}
{% set c = teacher.contacts %}
<div class="contacts" style="background-color: #f5f5f5; display: flex; align-items: center; gap: 20px;">
<div class="photo" style="width: 30%; padding: 10px;"><img style="max-width: 100%;" src="{{ teacher.photo }}" alt="{{ teacher.name }}"></div>
<div class="info" style="width: 70%; padding: 10px;">
{% if c.email %}<strong>Email</strong>: <a href="mailto:{{ c.email }}">{{ c.email }}</a>{% endif %}
{% if c.github %}<strong>GitHub</strong>: <a href="https://github.com/{{ c.github }}" target="_blank" rel="noopener">@{{ c.github }}</a>{% endif %}
{% if c.linkedin %}<strong>LinkedIn</strong>: <a href="https://www.linkedin.com/in/{{ c.linkedin }}/" target="_blank" rel="noopener">in/{{ c.linkedin }}</a>{% endif %}
{% if c.orcid %}<strong>ORCID</strong>:&nbsp;<a style="vertical-align: top;" href="https://orcid.org/{{ c.orcid }}" target="orcid.widget" rel="me noopener noreferrer"><img style="width: 1em; margin-inline-start: 0.5em;" src="https://orcid.org/sites/default/files/images/orcid_16x16.png" alt="ORCID iD icon">{{ c.orcid }}</a>{% endif %}
{% if c.wos %}<strong>Web of Science</strong>: <a href="https://www.webofscience.com/wos/author/record/{{ c.wos }}" target="_blank">{{ c.wos }}</a>{% endif %}
{% if c.scopus %}<strong>Scopus ID</strong>: <a href="https://www.scopus.com/authid/detail.uri?authorId={{ c.scopus }}" target="_blank">{{ c.scopus }}</a>{% endif %}
{% if c.google_scholar %}<strong>Google Scholar</strong>: <a href="https://scholar.google.com/citations?user={{ c.google_scholar }}" target="_blank">{{ c.google_scholar }}</a>{% endif %}
{% if c.intellect %}<strong>Сторінка на&nbsp;<a href="https://intellect.kpi.ua/profile/{{ c.intellect }}" target="_blank">intellect</a></strong>{% endif %}
{% if c.schedule %}<strong>Розклад занять</strong>: <a href="{{ c.schedule }}" target="_blank">schedule.kpi.ua</a>{% endif %}
{# ── Позаштатники: основне місце роботи ── #}
{% if teacher.external %}
{% if teacher.external.main_workplace %}<strong>Основне місце роботи</strong>: <a href="{{ teacher.external.main_workplace.url }}" target="_blank">{{ teacher.external.main_workplace.name }}</a>{% if teacher.external.main_workplace.position %}, {{ teacher.external.main_workplace.position }}{% endif %}{% endif %}
{% if teacher.external.nas_profile %}<strong>Сторінка на сайті</strong>: <a href="{{ teacher.external.nas_profile }}" target="_blank">НАН України</a>{% endif %}
{% endif %}
</div>
</div>

<hr style="margin: 20px 0; border: none; border-top: 1px solid #ddd;">

{# ── RESEARCH INTERESTS ── #}
{% if teacher.research_interests %}
<div class="science">
<h3 style="color: #1a3c6d; border-left: 5px solid #1a3c6d; padding-left: 10px;">Наукові інтереси</h3>
<ul>
{% for interest in teacher.research_interests %}
 	<li>{{ interest }};</li>
{% endfor %}
</ul>
</div>
<hr style="margin: 20px 0; border: none; border-top: 1px solid #ddd;">
{% endif %}

{# ── COURSES ── #}
{% if teacher.courses and (teacher.courses.bachelor or teacher.courses.master or teacher.courses.phd) %}
<div class="courses">
<h3 style="color: #1a3c6d; border-left: 5px solid #1a3c6d; padding-left: 10px;">Курси</h3>
{% set has_multiple_levels = (teacher.courses.bachelor and teacher.courses.master)
                          or (teacher.courses.bachelor and teacher.courses.phd)
                          or (teacher.courses.master and teacher.courses.phd) %}
{% if teacher.courses.bachelor %}
{% if has_multiple_levels %}{{ section_h4("Бакалаврат") }}{% endif %}
{{ course_list(teacher.courses.bachelor) }}
{% endif %}
{% if teacher.courses.master %}
{% if has_multiple_levels %}{{ section_h4("Магістратура") }}{% endif %}
{{ course_list(teacher.courses.master) }}
{% endif %}
{% if teacher.courses.phd %}
{% if has_multiple_levels %}{{ section_h4("PhD програма") }}{% endif %}
{{ course_list(teacher.courses.phd) }}
{% endif %}
</div>
<hr style="margin: 20px 0; border: none; border-top: 1px solid #ddd;">
{% endif %}

{# ── DUTIES ── #}
{% if teacher.duties %}
{% call collapsible("Посадові обов'язки") %}
<ol>
{% for duty in teacher.duties %}
 	<li>{{ duty }}</li>
{% endfor %}
</ol>
{% endcall %}
{% endif %}

{# ── CERTIFICATES ── #}
{% if teacher.certificates %}
{% call collapsible("Сертифікати та підвищення кваліфікації") %}
<ol style="padding-left: 20px; list-style: none; counter-reset: item;">
{% for cert in teacher.certificates %}
 	<li style="margin-bottom: 10px;"><strong>{{ cert.year }}</strong> — {% if cert.url %}<a href="{{ cert.url }}" target="_blank" rel="noopener">{{ cert.title }}</a>{% else %}{{ cert.title }}{% endif %}{% if cert.issuer %} ({{ cert.issuer }}){% endif %}</li>
{% endfor %}
</ol>
{% endcall %}
{% endif %}

{# ── METHODICAL MATERIALS ── #}
{% call collapsible("Методичні розробки") %}
{% set _n = teacher.name.split(" ", 1) %}[kpi_author_works author="{{ _n[0] }}, {{ _n[1] }}"]
{% endcall %}

{# ── PUBLICATIONS (ORCID shortcode) ── #}
{% if teacher.contacts.orcid %}
{% call collapsible("Наукові публікації") %}
[kpi_scholar orcid="{{ teacher.contacts.orcid }}"]
{% endcall %}
{% endif %}

{# ── CONFERENCES ── #}
{% if teacher.conferences %}
{% call collapsible("Конференції") %}
<ul>
{% for conf in teacher.conferences %}
 	<li>{% if conf.url %}<a href="{{ conf.url }}" target="_blank">{{ conf.title }}</a>{% else %}{{ conf.title }}{% endif %}{% if conf.date %}, {{ conf.date }}{% endif %}{% if conf.location %}, {{ conf.location }}{% endif %}</li>
{% endfor %}
</ul>
{% endcall %}
{% endif %}

{# ── NATIONAL PROJECTS ── #}
{% if teacher.national_projects %}
{% call collapsible("Національні наукові проєкти") %}
<ul>
{% for proj in teacher.national_projects %}
 	<li>{% if proj.url %}<a href="{{ proj.url }}" target="_blank">{{ proj.title }}</a>{% else %}{{ proj.title }}{% endif %}{% if proj.role %} — {{ proj.role }}{% endif %}{% if proj.years %} ({{ proj.years }}){% endif %}</li>
{% endfor %}
</ul>
{% endcall %}
{% endif %}

{# ── INTERNATIONAL PROJECTS ── #}
{% if teacher.international_projects %}
{% call collapsible("Міжнародні наукові проєкти") %}
<ul>
{% for proj in teacher.international_projects %}
 	<li>{% if proj.url %}<a href="{{ proj.url }}" target="_blank">{{ proj.title }}</a>{% else %}{{ proj.title }}{% endif %}{% if proj.role %} — {{ proj.role }}{% endif %}{% if proj.years %} ({{ proj.years }}){% endif %}</li>
{% endfor %}
</ul>
{% endcall %}
{% endif %}

{# ── ACHIEVEMENTS ── #}
{% if teacher.achievements %}
{% call collapsible("Наукова діяльність та ключові досягнення") %}
<ul>
{% for item in teacher.achievements %}
 	<li>{{ item }}</li>
{% endfor %}
</ul>
{% endcall %}
{% endif %}

{# ── STUDENTS ── #}
{% set _parts = teacher.name.split() %}
{% call collapsible("Керівництво студентськими дослідженнями") %}
[kpi_works advisor="{{ _parts[0] }}, {{ _parts[1][0] }}"]
{% endcall %}

{# ── BIOGRAPHY ── #}
{% if teacher.biography %}
{% call collapsible("Біографія") %}
{{ teacher.biography | safe }}
{% endcall %}
{% endif %}

</div>





